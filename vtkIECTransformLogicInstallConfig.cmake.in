@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(VTK 9.2 REQUIRED COMPONENTS CommonTransforms)

include("${CMAKE_CURRENT_LIST_DIR}/vtkIECTransformLogicTargets.cmake")

set_and_check(vtkIECTransformLogic_CMAKE_DIR "@PACKAGE_vtkIECTransformLogic_INSTALL_CMAKE_DIR@")
set_and_check(vtkIECTransformLogic_INCLUDE_DIRS "@PACKAGE_vtkIECTransformLogic_INSTALL_INCLUDE_DIR@")
set_and_check(vtkIECTransformLogic_LIB_DIR "@PACKAGE_vtkIECTransformLogic_INSTALL_LIB_DIR@")
set(VTK_DIR "@VTK_DIR@")

set(vtkIECTransformLogic_USE_UTF8 "@vtkIECTransformLogic_USE_UTF8@")

check_required_components(vtkIECTransformLogic)
